cargo new catch_the_stars
cd catch_the_stars
[dependencies]
bevy = "0.14"
rand = "0.8"
use bevy::prelude::*;
use rand::Rng;

#[derive(Component)]
struct Player;

#[derive(Component)]
struct Star;

fn main() {
    App::new()
        .add_plugins(DefaultPlugins.set(WindowPlugin {
            primary_window: Some(Window {
                title: "Catch the Stars!".into(),
                resolution: (800.0, 600.0).into(),
                ..default()
            }),
            ..default()
        }))
        .add_systems(Startup, setup)
        .add_systems(Update, (player_movement, spawn_stars, move_stars, check_collision))
        .run();
}

fn setup(mut commands: Commands, asset_server: Res<AssetServer>) {
    commands.spawn(Camera2dBundle::default());

    commands.spawn((
        SpriteBundle {
            texture: asset_server.load("player.png"),
            transform: Transform::from_xyz(0.0, -250.0, 0.0),
            ..default()
        },
        Player,
    ));
}

fn player_movement(
    keyboard_input: Res<Input<KeyCode>>,
    mut query: Query<&mut Transform, With<Player>>,
    time: Res<Time>,
) {
    let speed = 300.0;
    for mut transform in &mut query {
        if keyboard_input.pressed(KeyCode::Left) {
            transform.translation.x -= speed * time.delta_seconds();
        }
        if keyboard_input.pressed(KeyCode::Right) {
            transform.translation.x += speed * time.delta_seconds();
        }
    }
}

fn spawn_stars(
    mut commands: Commands,
    asset_server: Res<AssetServer>,
    time: Res<Time>,
    mut timer: Local<f32>,
) {
    *timer += time.delta_seconds();
    if *timer > 1.0 {
        *timer = 0.0;
        let mut rng = rand::thread_rng();
        let x = rng.gen_range(-350.0..350.0);
        commands.spawn((
            SpriteBundle {
                texture: asset_server.load("star.png"),
                transform: Transform::from_xyz(x, 300.0, 0.0),
                ..default()
            },
            Star,
        ));
    }
}

fn move_stars(mut query: Query<&mut Transform, With<Star>>, time: Res<Time>) {
    let speed = 200.0;
    for mut transform in &mut query {
        transform.translation.y -= speed * time.delta_seconds();
    }
}

fn check_collision(
    mut commands: Commands,
    player_query: Query<&Transform, With<Player>>,
    star_query: Query<(Entity, &Transform), With<Star>>,
) {
    if let Ok(player_transform) = player_query.get_single() {
        for (star_entity, star_transform) in &star_query {
            let distance = player_transform
                .translation
                .distance(star_transform.translation);
            if distance < 50.0 {
                commands.entity(star_entity).despawn();
                println!("⭐ Star collected!");
            }
        }
    }
}
